#!/bin/bash
set -e

LEGACY_PROXY_FILE="${TRIM_PKGVAR}/.proxy"
PROCESS_PROXY_FILE="${TRIM_PKGVAR}/.process-proxy"
VENV="${TRIM_PKGVAR}/venv"

get_config_dir() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local config_dir="${paths%%:*}"
    [ -n "$config_dir" ] || config_dir="${TRIM_PKGVAR}/config"
    printf '%s' "$config_dir"
}

validate_proxy() {
    local proxy="$1"
    [ -n "$proxy" ] || return 0
    case "$proxy" in
        http://*|https://*) ;;
        *) install_log "代理地址必须以 http:// 或 https:// 开头"; return 1 ;;
    esac
}

save_app_proxy() {
    local proxy="$1"
    local config_dir="$(get_config_dir)"
    local app_env="${config_dir}/app.env"
    local temp_env="${app_env}.tmp.$$"
    validate_proxy "$proxy"
    mkdir -p "$config_dir"
    if [ -f "$app_env" ]; then
        awk -v value="$proxy" '
            BEGIN { updated = 0; quote = sprintf("%c", 39) }
            /^[[:space:]]*PROXY_HOST[[:space:]]*=/ {
                if (!updated) print "PROXY_HOST=" quote value quote
                updated = 1
                next
            }
            { print }
            END { if (!updated) print "PROXY_HOST=" quote value quote }
        ' "$app_env" > "$temp_env"
        chown --reference="$app_env" "$temp_env" 2>/dev/null || true
    else
        printf "PROXY_HOST='%s'\n" "$proxy" > "$temp_env"
        if [ -n "${TRIM_UID:-}" ] && [ -n "${TRIM_GID:-}" ]; then
            chown "${TRIM_UID}:${TRIM_GID}" "$temp_env" 2>/dev/null || true
        fi
    fi
    chmod 600 "$temp_env"
    mv -f "$temp_env" "$app_env"
}

save_process_proxy() {
    local proxy="$1"
    if [ -z "$proxy" ]; then
        rm -f "$PROCESS_PROXY_FILE"
        return 0
    fi
    validate_proxy "$proxy"
    printf '%s\n' "$proxy" > "$PROCESS_PROXY_FILE"
    chmod 600 "$PROCESS_PROXY_FILE"
}

migrate_legacy_proxy() {
    [ -s "$LEGACY_PROXY_FILE" ] || { rm -f "$LEGACY_PROXY_FILE"; return 0; }
    local proxy="$(cat "$LEGACY_PROXY_FILE")"
    save_app_proxy "$proxy"
    rm -f "$LEGACY_PROXY_FILE"
    install_log "旧版全进程代理已迁移为 MoviePilot 应用代理"
}

service_postinst() {
    migrate_legacy_proxy
    [ -z "${wizard_proxy:-}" ] || save_app_proxy "$wizard_proxy"
    [ -z "${wizard_process_proxy:-}" ] || save_process_proxy "$wizard_process_proxy"
    local bundled_runtime="${TRIM_APPDEST}/runtime/venv.tgz"
    if [ -f "$bundled_runtime" ]; then
        rm -rf "$VENV"
        tar -xzf "$bundled_runtime" -C "${TRIM_PKGVAR}"
        chmod -R u+rwX,go+rX "$VENV" 2>/dev/null || true
        [ -x "${VENV}/bin/python" ] || { install_log "离线运行时解压失败"; return 1; }
    fi
    mkdir -p "${TRIM_PKGVAR}/core"
    chown -R "${TRIM_UID}:${TRIM_GID}" "${TRIM_PKGVAR}" 2>/dev/null || true
    chown -R "${TRIM_UID}:${TRIM_GID}" "${TRIM_APPDEST}" 2>/dev/null || true
}

service_postconfig() {
    migrate_legacy_proxy
    if [ -n "${wizard_proxy:-}" ]; then
        save_app_proxy "$wizard_proxy"
    elif [ "${wizard_clear_app_proxy:-false}" = "true" ]; then
        save_app_proxy ""
    fi
    if [ -n "${wizard_process_proxy:-}" ]; then
        save_process_proxy "$wizard_process_proxy"
    elif [ "${wizard_clear_process_proxy:-false}" = "true" ]; then
        save_process_proxy ""
    fi
}

remove_shared_data() {
    local paths="${TRIM_DATA_SHARE_PATHS:-}"
    local path=""
    local parent=""

    while [ -n "$paths" ]; do
        case "$paths" in
            *:*)
                path="${paths%%:*}"
                paths="${paths#*:}"
                ;;
            *)
                path="$paths"
                paths=""
                ;;
        esac

        # Delete only data-share paths declared by this package.
        case "$path" in
            */moviepilot/config|*/moviepilot/logs|*/moviepilot/exports|*/moviepilot/runtime)
                [ -d "$path" ] && rm -rf -- "$path"
                parent="${path%/*}"
                ;;
            *)
                install_log "Skip unexpected shared path: $path"
                ;;
        esac
    done

    # Remove the application root only when nothing else remains in it.
    [ -z "$parent" ] || rmdir "$parent" 2>/dev/null || true
}

remove_private_data_roots() {
    local app_name="${TRIM_APPNAME:-}"
    local volume_root=""
    local target=""

    [ "$app_name" = "moviepilot" ] || { install_log "Skip private data cleanup for unexpected app: $app_name"; return 1; }
    case "${TRIM_PKGVAR:-}" in
        */@appdata/moviepilot) volume_root="${TRIM_PKGVAR%/@appdata/moviepilot}" ;;
        *) install_log "Skip private data cleanup for unexpected TRIM_PKGVAR: ${TRIM_PKGVAR:-}"; return 1 ;;
    esac

    for target in \
        "${volume_root}/@appdata/moviepilot" \
        "${volume_root}/@apphome/moviepilot" \
        "${volume_root}/@appconf/moviepilot" \
        "${volume_root}/@appmeta/moviepilot" \
        "${volume_root}/@apptemp/moviepilot" \
        "${volume_root}/@appshare/moviepilot"; do
        case "$target" in
            "${volume_root}"/@appdata/moviepilot|\
            "${volume_root}"/@apphome/moviepilot|\
            "${volume_root}"/@appconf/moviepilot|\
            "${volume_root}"/@appmeta/moviepilot|\
            "${volume_root}"/@apptemp/moviepilot|\
            "${volume_root}"/@appshare/moviepilot)
                [ ! -e "$target" ] || rm -rf -- "$target"
                ;;
            *)
                install_log "Skip unexpected private data path: $target"
                return 1
                ;;
        esac
    done
}

service_postuninst() {
    [ "${wizard_delete_data:-false}" = "true" ] || return 0
    remove_shared_data
    remove_private_data_roots
}

service_postupgrade() {
    mkdir -p "${TRIM_PKGVAR}/core"
    service_postinst
}
